{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniCut Pro Studio",
  "version": "0.1.0",
  "identifier": "com.omnicut.prostudio",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "https://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build:desktop",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniCut Pro Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0C0D10",
        "dragDropEnabled": false,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
