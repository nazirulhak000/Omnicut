# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes vars prefixed VITE_ to client code, via import.meta.env.
#
# IMPORTANT: anything under import.meta.env.VITE_* is baked into the built
# JS bundle at build time. It is NOT a secret from anyone who can open the
# page / view source / inspect network requests -- it is only as private as
# the page itself. That's acceptable for a local single-user tool, but do
# not put anything here you would not want visible to any visitor.

# Shared-secret API key for the local backend (scripts/auth.py), sent back
# as the X-API-Key header on every request (see frontend/src/api.js). Must
# match the backend's OMNICUT_API_KEY (see root .env.example). Leave blank
# while the backend has no key configured -- the header is only sent when
# this has a value, so the permissive/no-auth setup keeps working unchanged.
VITE_API_KEY=
