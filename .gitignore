# Generated timeline filmstrips (rebuilt on demand from source clips)
05_Covers_Thumbnails/.filmstrips/
.playwright-mcp/
vision_frame_*.png
test_*.wav
06_Archive/*
!06_Archive/.gitkeep

# Voice preview cache (rebuilt automatically by voice engine)
02_Assets/Voiceover/previews/

# Frontend voice cache (served statically, rebuilt on demand)
frontend/public/voice_cache/

# Runtime-generated product database (rebuilt from scraper)
_Docs/products.json

# SQLite store backing ProductStore/PostLog (scripts/db.py) + WAL/SHM files
_Docs/store.db
_Docs/store.db-wal
_Docs/store.db-shm
_Docs/export_registry.json

# Runtime-generated shot lists (scripts/shot_lists_store.py, rebuilt any
# time a shot list is (re)generated for an angle)
_Docs/shot_lists.json

# Runtime-generated guided-take recording sessions (scripts/recording_sessions.py)
_Docs/recording_sessions.json
