{
  "manifest_version": 3,
  "name": "OmniCut TikTok Post Helper",
  "version": "0.2.0",
  "description": "ระบบช่วยกรอกไฟล์วิดีโอ ปก และแคปชั่นลงหน้า TikTok Studio อัตโนมัติในคลิกเดียว สำหรับ OmniCut Pro Studio",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "storage", "sidePanel", "scripting", "windows"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OmniCut TikTok Post Helper (เปิดแถบข้าง)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
