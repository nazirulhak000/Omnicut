# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Google AI Studio key. Powers Gemini Flash TTS (scripts/gemini_tts_engine.py)
# and every AI-bridge task (scripts/ai_bridge.py: product summaries, angle
# ideas, scripts, captions). Get one free at https://aistudio.google.com/apikey
#
# Without this set, ai_bridge.py falls back to a copy-paste panel in the UI --
# the app still works, it just needs a person to run the prompt manually.
GEMINI_API_KEY=

# Freesound token, for scripts/fetch_freesound_sfx.py -- a manual, occasional
# CLI that fills gaps in 02_Assets/SFX/ with CC0 (no-attribution) sound
# effects. Create a free account then request a credential at
# https://freesound.org/apiv2/apply -- use the "Api key" value, not the
# Client secret. This is a search/read-only token; nothing here can upload,
# rate, or modify anything on Freesound.
FREESOUND_API_KEY=
