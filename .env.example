# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Google AI Studio key. Powers Gemini Flash TTS (scripts/gemini_tts_engine.py)
# and every AI-bridge task (scripts/ai_bridge.py: product summaries, angle
# ideas, scripts, captions). Get one free at https://aistudio.google.com/apikey
#
# Without this set, ai_bridge.py falls back to a copy-paste panel in the UI --
# the app still works, it just needs a person to run the prompt manually.
GEMINI_API_KEY=

# Freesound token, for scripts/fetch_freesound_sfx.py -- a manual, occasional
# CLI that fills gaps in 02_Assets/SFX/ with CC0 (no-attribution) sound
# effects. Create a free account then request a credential at
# https://freesound.org/apiv2/apply -- use the "Api key" value, not the
# Client secret. This is a search/read-only token; nothing here can upload,
# rate, or modify anything on Freesound.
FREESOUND_API_KEY=

# Shared-secret API key for the local backend (scripts/api_server.py).
# Local single-app hardening, NOT a multi-tenant auth system -- one owner,
# one key, checked via a constant-time compare on every request.
#
# Without this set, the API runs with NO authentication: any process that
# can reach this port (any web page open in your browser included, since
# CORS_ORIGINS below still lets the frontend origin through) can drive the
# whole app -- AI generation, TikTok auto-post, file delete, render. That's
# fine on a machine only you use; a clear warning is logged at startup so
# it's never a silent hole. Set this before exposing the port beyond
# localhost.
#
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend and the Chrome extension both need to send this back as the
# `X-API-Key` header once it's set (see _Docs/SAAS_READINESS_PLAN.md P1
# item 5 for the follow-up wiring on each side).
OMNICUT_API_KEY=

# Comma-separated list of origins allowed to call the API via CORS.
# Defaults to the Vite dev server (frontend/vite.config.js, port 5173) if
# left blank -- never "*". The Chrome extension does not need to be listed
# here: its host_permissions in manifest.json already exempt its requests
# from CORS response-blocking.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Daily budget caps enforced BEFORE every paid AI/TTS call (scripts/quota.py)
# -- pre-flight check, not just after-the-fact logging. 0 disables a cap.
# Generous defaults (5,000,000 tokens/day, 500 THB-equivalent/day) act as a
# safety net against a runaway loop, not a tight cost control.
# DAILY_TOKEN_LIMIT=5000000
# DAILY_COST_THB_LIMIT=500
